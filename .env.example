# Copy to .env.local; never commit actual values.
# Existing signup persistence remains disabled for local/Preview QA.
BETA_SIGNUP_PERSISTENCE=disabled
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SITE_URL=

# Separate PrayTime CMS Demo project. Never use the signup project.
PRAYER_SUPABASE_URL=https://YOUR_DEMO_PROJECT.supabase.co
PRAYER_SUPABASE_PUBLISHABLE_KEY=
# Server only: sb_secret_... or legacy service_role key; never NEXT_PUBLIC_.
PRAYER_SUPABASE_SECRET_KEY=

# disabled (default) | local | protected-demo
# local only works without VERCEL, at localhost/127.0.0.1.
CMS_ADMIN_MODE=disabled
CMS_DEMO_ENV=false
# Set verified only AFTER independently verifying Vercel Deployment Protection.
CMS_DEPLOYMENT_PROTECTION=
# Protected Preview shared HTTP gateway; actual values stay server-only.
CMS_ADMIN_USERNAME=
# SHA-256 hex digest of the chosen gateway password, not the plaintext password.
CMS_ADMIN_PASSWORD_SHA256=
# Server-only random session signing secret, at least 32 characters. Never the login password.
CMS_ADMIN_SESSION_SECRET=
# Legacy fallback only when BOTH custom credential settings above are empty.
# Legacy username is demo, with a private random key of at least 32 characters.
CMS_ADMIN_ACCESS_KEY=
